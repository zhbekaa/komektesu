{
  "expo": {
    "name": "Komektesu",
    "slug": "komektesu",
    "scheme": "komektesu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zbeka.komektesu",
      "appleTeamId": "V374MGVX8P"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
